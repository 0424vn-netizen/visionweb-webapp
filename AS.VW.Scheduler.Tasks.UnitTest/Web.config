<?xml version="1.0"?>

<!--
  For more information on how to configure your ASP.NET application, please visit
  http://go.microsoft.com/fwlink/?LinkId=169433
  -->

<configuration>
  <configSections>
    <section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler, log4net"/>
    <section name="microsoft.web.services3" type="Microsoft.Web.Services3.Configuration.WebServicesConfiguration, Microsoft.Web.Services3, Version=3.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35"/>
  </configSections>
  <log4net>
    <appender name="RollingFileAppender" type="log4net.Appender.RollingFileAppender">
      <param name="File" value="Logs\\FE_Log.txt"/>
      <param name="AppendToFile" value="true"/>
      <param name="RollingStyle" value="Size"/>
      <param name="MaxSizeRollBackups" value="10"/>
      <param name="MaximumFileSize" value="2MB"/>
      <param name="StaticLogFileName" value="true"/>
      <layout type="log4net.Layout.PatternLayout">
        <param name="ConversionPattern" value="%d [%t] %-5p %c - %m%n"/>
      </layout>
    </appender>
    <root>
      <level value="DEBUG"/>
      <appender-ref ref="RollingFileAppender"/>
    </root>
  </log4net>
  <microsoft.web.services3>
    <policy fileName="wse3policyCache.config"/>
  </microsoft.web.services3>
    <system.web>
      <compilation debug="true" targetFramework="4.5" />
      <httpRuntime targetFramework="4.5" />
    </system.web>
  <appSettings>
    <add key="Report_WS_URL" value="http://vwreskin-cs-ws-qa.local/spanish/CsReportingServices.asmx"/>
    <add key="Report_WS_Token1" value="Zd8fFFrrOAGq+qH5hs7OhQ=="/>
    <add key="Report_WS_Token2" value="pd2ho0N4A+YqQpWsJfV3tw=="/>
    <add key="DocServer_WS_URL" value="http://192.168.119.6/DocProcessor.asmx"/>
    <add key="DocServer_DownloadUrl" value="http://192.168.119.6/ShowFile.aspx"/>
    <add key="Client_Id_Default" value="22"/>
    <add key="Export_Temp_Folder" value="ExportFiles/"/>
    <add key ="Export_Thread_Max" value="10"/>
    <add key="ServiceTimeout" value="10"/>
  </appSettings>

</configuration>
