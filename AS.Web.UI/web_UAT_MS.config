      <remove name="Telerik_RadUploadProgressHandler_ashx" />
      <add name="Telerik_RadUploadProgressHandler_ashx" path="Telerik.RadUploadProgressHandler.ashx" type="Telerik.Web.UI.RadUploadProgressHandler,Telerik.Web.UI" verb="*" />
      <remove name="Telerik_Web_UI_WebResource_axd" />
      <add name="Telerik_Web_UI_WebResource_axd" path="Telerik.Web.UI.WebResource.axd" type="Telerik.Web.UI.WebResource,Telerik.Web.UI" verb="*" />
      <add name="ChartImage_axd" path="ChartImage.axd" type="Telerik.Web.UI.ChartHttpHandler" verb="*" />
      <add name="ChartAxd.axd" path="ChartAxd.axd" verb="*" preCondition="integratedMode" type="Dundas.Charting.WebControl.ChartHttpHandler" resourceType="Unspecified" />
    </handlers>
	 <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="85899345"/> 
        <verbs allowUnlisted="true">
		<remove verb="HEAD" />
		<remove verb="OPTIONS" />
		<remove verb="TRACE" />
		<remove verb="PUT" />
		<remove verb="DELETE" />
		<remove verb="CONNECT" />
          <add verb="HEAD" allowed="false"/>
          <add verb="OPTIONS" allowed="false"/>
          <add verb="TRACE" allowed="false"/>
          <add verb="PUT" allowed="false"/>
          <add verb="DELETE" allowed="false"/>
          <add verb="CONNECT" allowed="false"/>
        </verbs>
      </requestFiltering>
    </security>
    <httpProtocol>
      <customHeaders>
        <!--Remove-->
        <remove name="X-Powered-By" />
        <remove name="Server"  />
		<remove name="P3P" />
		<remove name="X-Frame-Options" />
		<remove name="X-XSS-Protection" />
		<remove name="X-Content-Type-Options" />
		<remove name="Cache-Control" />
		<remove name="Pragma" />
		<remove name="Content-Security-Policy" />
		<remove name="Strict-Transport-Security" />

        <!--Add-->
		<!-- <add name="Cache-Control" value="no-cache, no-store, must-revalidate" /> -->
        <add name="Pragma" value="no-cache" />
        <add name="P3P" value="CP=&quot;NOI STA&quot;" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="X-XSS-Protection" value="1; mode=block" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Content-Security-Policy" value="style-src 'self' 'unsafe-inline';script-src 'self' 'unsafe-eval' 'unsafe-inline' https://tableau.aperia.local/javascripts/api/viz_v1.js;" />
        <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains" />
      </customHeaders>
    </httpProtocol>
    <staticContent>
      <remove fileExtension=".woff" />
      <mimeMap fileExtension=".woff" mimeType="application/octet-stream" />
    </staticContent>
    
	<httpErrors errorMode="DetailedLocalOnly">
	      <remove statusCode="400" subStatusCode="-1" />
	      <remove statusCode="401" subStatusCode="-1" />
	      <remove statusCode="403" subStatusCode="-1" />
	      <remove statusCode="404" subStatusCode="-1" />
	      <remove statusCode="405" subStatusCode="-1" />
	      <remove statusCode="406" subStatusCode="-1" />
	      <remove statusCode="412" subStatusCode="-1" />
	      <remove statusCode="500" subStatusCode="-1" />
	      <remove statusCode="501" subStatusCode="-1" />
	      <remove statusCode="502" subStatusCode="-1" />
	      <error statusCode="400" prefixLanguageFilePath="" path="/error.htm" responseMode="ExecuteURL" />
	      <error statusCode="401" prefixLanguageFilePath="" path="/error.htm" responseMode="ExecuteURL" />
	      <error statusCode="403" prefixLanguageFilePath="" path="/error.htm" responseMode="ExecuteURL" />
	      <error statusCode="404" prefixLanguageFilePath="" path="/error.htm" responseMode="ExecuteURL" />
	      <error statusCode="405" prefixLanguageFilePath="" path="/error.htm" responseMode="ExecuteURL" />
	      <error statusCode="406" prefixLanguageFilePath="" path="/error.htm" responseMode="ExecuteURL" />
	      <error statusCode="412" prefixLanguageFilePath="" path="/error.htm" responseMode="ExecuteURL" />
	      <error statusCode="500" prefixLanguageFilePath="" path="/error.htm" responseMode="ExecuteURL" />
	      <error statusCode="501" prefixLanguageFilePath="" path="/error.htm" responseMode="ExecuteURL" />
	      <error statusCode="502" prefixLanguageFilePath="" path="/error.htm" responseMode="ExecuteURL" />	  
	</httpErrors>
	
  </system.webServer>
