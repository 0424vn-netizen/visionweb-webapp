      during development.
    -->
    <compilation debug="true" targetFramework="4.5">
      <assemblies>
        <add assembly="Microsoft.Web.Services3, Version=3.0.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35" />
        <add assembly="System.Security, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B03F5F7F11D50A3A" />
      </assemblies>
    </compilation>
    <pages validateRequest="false" controlRenderingCompatibilityVersion="4.0" clientIDMode="AutoID">
      <controls>
        <add tagPrefix="asp" namespace="System.Web.UI" assembly="System.Web.Extensions, Version=3.5.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35" />
        <add tagPrefix="asp" namespace="System.Web.UI.WebControls" assembly="System.Web.Extensions, Version=3.5.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35" />
        <add tagPrefix="tek" namespace="Telerik.Web.UI" assembly="Telerik.Web.UI" />
        <add tagPrefix="as" namespace="AS.Controls.Global" assembly="App_Code" />
        <add tagPrefix="as" namespace="AS.Controls.Telerik" assembly="AS.Controls" />
        <add tagPrefix="as" namespace="AS.Web.UI.Controls" assembly="AS.Controls" />
        <add tagPrefix="as" namespace="AS.Controls" assembly="App_Code" />
        <add tagPrefix="as" namespace="AS.Controls.Chooser" assembly="AS.Controls" />
        <add tagPrefix="as" namespace="aperia.controls" assembly="KendoChart" />
