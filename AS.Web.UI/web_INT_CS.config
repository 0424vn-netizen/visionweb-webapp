  <!-- 
        The system.webServer section is required for running ASP.NET AJAX under Internet
        Information Services 7.0.  It is not necessary for previous version of IIS.
    -->
  <system.webServer>
    <validation validateIntegratedModeConfiguration="false" />
    <handlers>
      <remove name="ChartImage_axd" />
      <remove name="Telerik_Web_UI_SpellCheckHandler_axd" />
      <add name="Telerik_Web_UI_SpellCheckHandler_axd" path="Telerik.Web.UI.SpellCheckHandler.axd" type="Telerik.Web.UI.SpellCheckHandler,Telerik.Web.UI" verb="*" />
      <remove name="Telerik_Web_UI_DialogHandler_aspx" />
      <add name="Telerik_Web_UI_DialogHandler_aspx" path="Telerik.Web.UI.DialogHandler.aspx" type="Telerik.Web.UI.DialogHandler,Telerik.Web.UI" verb="*" />
      <remove name="Telerik_RadUploadProgressHandler_ashx" />
      <add name="Telerik_RadUploadProgressHandler_ashx" path="Telerik.RadUploadProgressHandler.ashx" type="Telerik.Web.UI.RadUploadProgressHandler,Telerik.Web.UI" verb="*" />
      <remove name="Telerik_Web_UI_WebResource_axd" />
      <add name="Telerik_Web_UI_WebResource_axd" path="Telerik.Web.UI.WebResource.axd" type="Telerik.Web.UI.WebResource,Telerik.Web.UI" verb="*" />
      <add name="ChartImage_axd" path="ChartImage.axd" type="Telerik.Web.UI.ChartHttpHandler" verb="*" />

    </handlers>
    <staticContent>
      <remove fileExtension=".woff" />
      <mimeMap fileExtension=".woff" mimeType="application/octet-stream" />
    </staticContent>
	<modules>
      <remove name="RadCompression" />
	  <remove name="RewriteModule" />
      <add name="RadCompression" type="Telerik.Web.UI.RadCompression" preCondition="integratedMode,runtimeVersionv2.0" />
      <add name="RewriteModule" type="AS.Web.UrlRewriting" />
	  <remove name="LogModule" />
      <!--<add name="LogModule" type="Aperia.Web.WebLogModule" />-->
    </modules>
	<!--47574 - Web Application Security Standard Upgrade - VisionWeb-->
    <security>
      <requestFiltering>
        <verbs allowUnlisted = "true">
			<remove verb="HEAD" />
			<remove verb="OPTIONS" />
			<remove verb="TRACE" />
			<remove verb="PUT" />
			<remove verb="DELETE" />
			<remove verb="CONNECT" />
          <add verb = "HEAD" allowed = "false"/>
          <add verb = "OPTIONS" allowed = "false"/>
          <add verb = "TRACE" allowed = "false"/>
          <add verb = "PUT" allowed = "false"/>
          <add verb = "DELETE" allowed = "false"/>
          <add verb = "CONNECT" allowed = "false"/>
        </verbs>
      </requestFiltering>
    </security>
    <httpProtocol>
      <customHeaders>
			<!--Remove-->
			<remove name="Cache-Control" />
			<remove name="Pragma" />
			<remove name="X-Frame-Options" />
			<remove name="X-XSS-Protection" />
			<remove name="X-Content-Type-Options" />
			<remove name="Content-Security-Policy" />
			<remove name="Strict-Transport-Security" />
        <add name="Cache-Control" value="cache, store" /> 
        <add name="Pragma" value="no-cache" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="X-XSS-Protection" value="1; mode=block" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Content-Security-Policy" value="style-src 'self' 'unsafe-inline';script-src 'self' 'unsafe-eval' 'unsafe-inline' https://js-agent.newrelic.com/nr-spa-1216.min.js https://bam.nr-data.net;form-action 'self' https://vwreskin-cs-int.local" />
        <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains" />

        <remove name="Server"  />
      </customHeaders>
    </httpProtocol>
    <!--End 47574-->
  </system.webServer>

<system.net>
    <defaultProxy enabled="false" useDefaultCredentials="false">
      <proxy/>
      <bypasslist/>
      <module/>
    </defaultProxy>
  </system.net>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Telerik.Web.UI" publicKeyToken="121fae78165ba3d4" />
	    <bindingRedirect oldVersion="2013.2.717.45-2016.2.607.45" newVersion="2020.2.617.45"/>
      </dependentAssembly>
        <dependentAssembly>
            <assemblyIdentity name="WebGrease" publicKeyToken="31bf3856ad364e35" culture="neutral" />
            <bindingRedirect oldVersion="0.0.0.0-1.6.5135.21930" newVersion="1.6.5135.21930" />
        </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>