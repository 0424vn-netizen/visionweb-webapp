<%@ Master Language="C#" AutoEventWireup="true" CodeFile="MasterPage.master.cs" Inherits="MasterPage" %>

<%@ Register Src="~/UserControls/HeaderMenuMasterUserControl.ascx" TagName="HeaderMenuMasterUserControl" TagPrefix="uc" %>
<!DOCTYPE html>
<html lang="en">
<head id="Head1" runat="server">
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <title></title>
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
    <tek:RadCodeBlock ID="RadCodeBlock1" runat="server">
        <link href="<%=RootUrl%>res/css/kendo/kendo.common.min.css" rel="stylesheet" type="text/css" />
        <link href="<%=RootUrl%>res/css/kendo/kendo.dataviz.default.min.css" rel="stylesheet" type="text/css" />
        <link href="<%=RootUrl%>res/css/print.css" rel="stylesheet" type="text/css" />
        <link href="<%=RootUrl%>res/css/chosen/chosen.min.css" rel="stylesheet" type="text/css" />
        <link href="<%=RootUrl%>res/css/jquery-ui.min.css" rel="stylesheet" type="text/css" />
        <link href="<%=RootUrl%>res/css/datepicker.css" rel="stylesheet" type="text/css">

        <link href="<%=RootUrl%>res/css/as_alert.css" rel="stylesheet" type="text/css">
        <link href="<%=RootUrl%>res/css/_advanced_filter.min.css" rel="stylesheet" type="text/css">

        <script src="<%=RootUrl%>res/js/jquery/jquery-3.6.0.min.js" type="text/javascript"></script>
        <script src="<%=RootUrl%>res/js/jquery/jquery-migrate-3.3.2.min.js" type="text/javascript"></script>

        <script src="<%=RootUrl%>res/js/jquery/jquery.formatCurrency-1.4.0.js" type="text/javascript"></script>
        <script src="<%=RootUrl%>res/js/jquery/jquery.cookie.js" type="text/javascript"></script>
        <script src="<%=RootUrl%>res/js/jquery/jquery.ba-postmessage.js" type="text/javascript"></script>
        <script src="<%=RootUrl%>res/js/jquery/jquery-ui.min.js" type="text/javascript"></script>

        <script src="<%=RootUrl%>res/js/kendo/kendo.dataviz.min.js" type="text/javascript"></script>
        <script src="<%=RootUrl%>res/js/bootstrap/bootstrap.min.js" type="text/javascript"></script>
        <script src="<%=RootUrl%>res/js/bootstrap/bootstrap-hover-dropdown.min.js" type="text/javascript"></script>
        <script src="<%=RootUrl%>res/js/chosen/chosen.jquery.js" type="text/javascript"></script>
        <!--[if lt IE 9]>
          <script src="<%=RootUrl%>res/js/bootstrap/html5shiv.js" type="text/javascript"></script>
          <script src="<%=RootUrl%>res/js/bootstrap/respond.min.js" type="text/javascript"></script>
        <![endif]-->

        <script src="<%=RootUrl %>res/js/common/common.js" type="text/javascript"></script>
        <script src="<%=RootUrl %>res/js/common/grid.js" type="text/javascript"></script>
        <script src="<%=RootUrl %>res/js/common/modal.js" type="text/javascript"></script>
        <script src="<%=RootUrl %>res/js/common/sessiontimeout.js" type="text/javascript"></script>
        <script src="<%=RootUrl %>res/js/common/ajaxmanager.js" type="text/javascript"></script>
        <script src="<%=RootUrl %>res/js/common/reportfilter.js" type="text/javascript"></script>
        <script src="<%=RootUrl %>res/js/common/uxexport.js" type="text/javascript"></script>
        <script src="<%=RootUrl %>res/js/common/base.alert.js" type="text/javascript"></script>
        <script src="<%=RootUrl %>res/js/common/advancedFilter.js" type="text/javascript"></script>
        <script src="<%=RootUrl %>res/js/common/core.search.control.js" type="text/javascript"></script>
        <script src="<%=RootUrl %>res/js/common/MultiSelector.js" type="text/javascript"></script>
    </tek:RadCodeBlock>
</head>

<body>
    <form id="form1" runat="server">
        <tek:RadScriptManager ID="uxMasterScriptManager" runat="server" AsyncPostBackTimeout="120"
            EnablePageMethods="true" />
        <tek:RadWindowManager ID="uxWindowManager" runat="server" Modal="true" RenderMode="Classic" OnClientClose="PopupModalClose"
            VisibleStatusbar="false" AutoSize="True" Overlay="True" ShowOnTopWhenMaximized="false" ShowContentDuringLoad="false">
            <Windows>
                <tek:RadWindow ID="RadWindow1" runat="server" />
                <tek:RadWindow ID="RadWindow2" runat="server" />
                <tek:RadWindow ID="RadWindow3" runat="server" />
                <tek:RadWindow ID="RadWindow4" runat="server" />
            </Windows>
        </tek:RadWindowManager>
        <tek:RadAjaxManager runat="server" ID="uxRadAjaxManager" DefaultLoadingPanelID="uxLoadingPanel">
            <ClientEvents OnRequestStart="masterAjax_requestStart" OnResponseEnd="masterAjax_responseEnd" />
        </tek:RadAjaxManager>
        <tek:RadAjaxLoadingPanel runat="server" ID="uxLoadingPanelCustom" BackgroundPosition="Center"
            OnClientShowing="customLoadingPanel_OnClientShowing" />
        <tek:RadAjaxLoadingPanel runat="server" ID="uxLoadingPanel" BackgroundPosition="Center" />
        <tek:RadStyleSheetManager ID="RadStyleSheetManager1" runat="server" EnableStyleSheetCombine="true" />
        <div class="display-none">
            <as:RadAjaxLoadingPanel runat="server" ID="uxInvisiblePanel" CssClass="display-none"
                BackgroundPosition="none" />
            <tek:RadComboBox runat="server" ID="uxDummy"></tek:RadComboBox>
        </div>
        <!--Header-->

        <!--This element was created to fix the issue on popup display incorrect position-->
        <div id="siteHeaderEmpty"></div>
        <%--Do not remove this comment--%>
        <asp:PlaceHolder ID="uxHeaderMenu" runat="server">
            <div class="welcomebar navbar navbar-inverse navbar-fixed-top" id="uxWelcomeBar" runat="server">
                <div class="navbar-text pull-left navbar-text-left">
                    <%--<as:Literal ID="tlWelcome" runat="server" Text="Welcome," meta:resourcekey="tlWelcomeResource1"></as:Literal>&nbsp;--%>
                    <asp:Label ID="uxUserInfoWithoutLink" runat="server" Text="" />
                    <asp:HyperLink ID="uxUserProfile" CssClass="navbar-link user-name ellipsis" runat="server" meta:resourcekey="uxUserProfileResource1">
                        <asp:Literal ID="uxUserInfo" runat="server" Text="" meta:resourcekey="uxUserInfoResource1" />
                    </asp:HyperLink>
                    <asp:PlaceHolder runat="server" ID="uxPnlSiteAccess">|
                            <asp:HyperLink runat="server" ID="uxSiteAccessLink" CssClass="navbar-link pointer" Text="Site Access"
                                meta:resourcekey="uxSiteAccess" /></asp:PlaceHolder>
                    <asp:PlaceHolder runat="server" ID="uxPanelLanding">|
                        <asp:HyperLink runat="server" ID="uxLandingPage" CssClass="navbar-link" Text="Landing Page"
                            meta:resourcekey="uxLandingPageResource1" /></asp:PlaceHolder>
                    <asp:PlaceHolder runat="server" ID="uxPanelCase">|
                        <asp:HyperLink ID="uxOpenNewCase" NavigateUrl="#" CssClass="navbar-link" Text="Open New Case" runat="server" meta:resourcekey="uxOpenNewCaseResource1"></asp:HyperLink>
                        |
                        <asp:HyperLink ID="uxMyCase" NavigateUrl="#" CssClass="navbar-link" runat="server" Text="My Cases" meta:resourcekey="uxMyCaseResource1"></asp:HyperLink>
                    </asp:PlaceHolder>
                    <asp:PlaceHolder runat="server" ID="uxPlhMPAList" Visible="False">|
                        <asp:HyperLink ID="uxMPAList" NavigateUrl="/boarding/taskmanager/mpa" CssClass="navbar-link" runat="server" Text="MPA List" meta:resourcekey="uxMPAListResource1"></asp:HyperLink>
                    </asp:PlaceHolder>
                    <asp:PlaceHolder runat="server" ID="uxPlhTaskList" Visible="False">|
                        <asp:HyperLink ID="uxTaskList" NavigateUrl="/boarding/taskmanager/tasklist" CssClass="navbar-link" runat="server" Text="Task List" meta:resourcekey="uxTaskListResource1"></asp:HyperLink>
                    </asp:PlaceHolder>
                    <asp:PlaceHolder runat="server" ID="uxPlAddNewMerchant" Visible="false">|
                        <asp:HyperLink ID="uxAddNewMerchant" NavigateUrl="#" CssClass="navbar-link" Text="Add New Merchant" runat="server" meta:resourcekey="uxAddNewMerchantResource1"></asp:HyperLink></asp:PlaceHolder>
                </div>
                <div class="pull-right">
                    <!--Alert Feed-->
                    <div id="div-alert" class="alert-feed pull-right">
                        <%--<div class="alert-feed icon-alert new"></div>--%>
                    </div>
                    <as:PlaceHolder ID="plhdLanguage" runat="server" Visible="false">
                        <div class="navbar-text pull-right welcome-bar">
                            <!--SwitchLanguage-->
                            <%--Do not remove this comment--%>
                            <tek:RadComboBox ID="drpLanguage" runat="server" AutoPostBack="true" Width="85px" DropDownCssClass="select-lang-dropdown"
                                OnSelectedIndexChanged="drpLanguage_SelectedIndexChanged">
                            </tek:RadComboBox>
                            <!--/SwitchLanguage-->
                            <%--Do not remove this comment--%>
                        </div>
                    </as:PlaceHolder>
                    <p class="navbar-text pull-right navbar-text-right">
                        <asp:Literal runat="server" ID="uxLastLogin" meta:resourcekey="uxLastLoginResource1" />
                        <asp:PlaceHolder runat="server" ID="uxPanelEnvironment">
                            <asp:Literal runat="server" ID="uxEnvironment" />
                            |
                        </asp:PlaceHolder>
                        <asp:PlaceHolder runat="server" ID="uxPanelHome">
                            <asp:HyperLink runat="server" ID="uxHomeLink" CssClass="navbar-link" Text="Home" meta:resourcekey="uxHomeLinkResource1" />
                            |
                        </asp:PlaceHolder>
                        <as:LinkButton ID="uxLogOffLink" OnClientClick="return doLogOff();" OnClick="uxLogout_Click"
                            CssClass="navbar-link" runat="server" Text="LOG OFF" meta:resourcekey="uxLogOffLinkResource1"></as:LinkButton>

                    </p>
                </div>


            </div>
            <div class="site-header" id="siteHeader" runat="server"></div>
            <uc:HeaderMenuMasterUserControl runat="server" ID="uxMasterHeaderMenuControl" />
        </asp:PlaceHolder>
        <asp:HiddenField ID="uxIsWindowOpened" runat="server" />
        <script type="text/javascript">
            var uxWellcomeBar = '<%= uxWelcomeBar.ClientID %>';
            var rootURL = '<%=RootUrl %>';
            var windowManagerID = '<%=uxWindowManager.ClientID %>';
            var uxLoadingPanel_ClientID = '<%= uxLoadingPanel.ClientID%>';
            var isIframeSupported = '<%=GeneralFuncsLib.IsIFrameSupported() %>';
            var uxIsWindowOpened = '<%=uxIsWindowOpened.ClientID %>';
            var hasCMSession = '<%=(SessionManager.CaseSiteJumpTicket == null || SessionManager.CaseSiteJumpTicket == Guid.Empty) ? "false": "true" %>';
            var urlCMLogout = '<%= WebSiteSettings.CaseMgmtGateUrl %>?logout=1';
            var PageContentClientID = "<%= mainContent.ClientID %>";
            var messageViewUnreadMessagesModal = "<%=ResolveUrl("~")%>Message_ViewUnreadMessagesModal.aspx";
            var isOpenRecurringSystemMessage = '<%= GeneralFuncsLib.GetCookie("is_open_recurring_system_message") %>';
            // 38605: Keep alive to auto clear WIP status
            var isMCF = '<%= GeneralFuncsLib.IsMCFRisk().ToString().ToLower() %>' == "true";
            if (isMCF) {
                var timeInterval = '<%= WebSiteSettings.RiskMCFKeepAlive %>';
                var intervalId = setInterval(function () {
                    $.ajax({
                        type: "post",
                        url: rootURL + "Header.aspx/KeepAlive",
                        async: true,
                        contentType: "application/json",
                        dataType: "json",
                        success: function (response) { },
                        error: function (xhr, status, error) {
                            if (xhr.status >= 400 && xhr.status < 500) {
                                clearInterval(intervalId);
                            }
                        }
                    });
                }, timeInterval);
            }
        </script>
        <!--/Header-->
        <%--Do not remove this comment--%>
        <div class="white-bg-shadow"></div>
        <div id="popupContentOverlay" class="popup-content-overlay hide"></div>
        <div id="mainContent" runat="server" class="container">
            <asp:ContentPlaceHolder ID="ContentPage" runat="server">
            </asp:ContentPlaceHolder>
        </div>
        <script src="<%=RootUrl %>res/js/MasterPage.js" type="text/javascript"></script>
        <script>
            var AlertName = '<%= Resources.LanguageResource.ActionBar_Alert_Name %>';
            var AlertTitle = '<%= Resources.LanguageResource.ActionBar_Alert_Title %>';
            var AlertTooltip = '<%= Resources.LanguageResource.ActionBar_Alert_Tooltip %>';

            var actionBarModule = new ActionBarModule();
            // alertTime unit="s"

            actionBarModule.addItem({
                id: "alert", name: AlertName, title: AlertTitle, icon: "icon-notification", tooltip: AlertTooltip, feedTemplate: "", index: 2, alertTime: 10, alertTimeClose: 5,
                getMsgUri: "<%=ResolveUrl("~")%>Dashboard.aspx/GetAlert", getMsgFeedUri: "<%=ResolveUrl("~")%>Dashboard.aspx/GetAlertFeed",
                updateMsgStatusUri: "<%=ResolveUrl("~")%>Dashboard.aspx/UpdateAlert", deleteGroupMsgUri: "<%=ResolveUrl("~")%>Dashboard.aspx/DeleteGroupAlert",
                getSourcesUri: "<%=ResolveUrl("~")%>Dashboard.aspx/GetAlertSources"
            });
            var content = {
                Delete: '<%= Resources.LanguageResource.ActionBar_Delete %>',
                Clear: '<%= Resources.LanguageResource.ActionBar_Clear %>',
                Close: '<%= Resources.LanguageResource.ActionBar_Close %>',
                ToDay: '<%= Resources.LanguageResource.ActionBar_ToDay %>',
                Yesterday: '<%= Resources.LanguageResource.ActionBar_Yesterday %>',
                ThisWeek: '<%= Resources.LanguageResource.ActionBar_ThisWeek %>',
                ThisMonth: '<%= Resources.LanguageResource.ActionBar_ThisMonth %>',
                LastWeek: '<%= Resources.LanguageResource.ActionBar_LastWeek %>',
                TwoWeeksAgo: '<%= Resources.LanguageResource.ActionBar_TwoWeeksAgo %>',
                ThreeWeeksAgo: '<%= Resources.LanguageResource.ActionBar_ThreeWeeksAgo %>',
                LastMonth: '<%= Resources.LanguageResource.ActionBar_LastMonth %>',
                Older: '<%= Resources.LanguageResource.ActionBar_Older %>',
                CloseText: '<%= Resources.LanguageResource.ActionBar_CloseText %>',
                ViewText: '<%= Resources.LanguageResource.ActionBar_ViewText%>',
                DismissText: '<%= Resources.LanguageResource.ActionBar_DismissText %>',

                MarkRead: '<%= Resources.LanguageResource.Alert_MarkRead %>',
                MarkAllRead: '<%= Resources.LanguageResource.Alert_MarkAllRead %>',
                UnRead: '<%= Resources.LanguageResource.Alert_UnRead %>',
                ClearAll: '<%= Resources.LanguageResource.Alert_ClearAll %>',
                Show: '<%= Resources.LanguageResource.Alert_Show %>',
                NoItem: '<%= Resources.LanguageResource.Alert_NoItem %>',
                NoItemTitle: '<%= Resources.LanguageResource.Alert_NoItemTitle %>',
                OpenFeed: '<%= Resources.LanguageResource.Alert_OpenFeed %>',
                CloseFeed: '<%= Resources.LanguageResource.Alert_CloseFeed %>',
                DismissAll: '<%= Resources.LanguageResource.Alert_DismissAll %>',

                CM: '<%= Resources.LanguageResource.Alert_Data_CaseManagement %>',
                ALICE: '<%= Resources.LanguageResource.Alert_Data_Alice %>',
                All: '<%= Resources.LanguageResource.Alert_Data_All %>',
                Read: '<%= Resources.LanguageResource.Alert_Data_Read %>',
                UnReadText: '<%= Resources.LanguageResource.Alert_Data_UnRead %>',

                SourceText: '<%= Resources.LanguageResource.Alert_Source %>',
                StatusText: '<%= Resources.LanguageResource.Alert_Status %>',
                MultipleText: '<%= Resources.LanguageResource.Alert_Multiplechoices %>',
                SingleText: '<%= Resources.LanguageResource.Alert_Singlechoices %>',
                AlertMsgSpecialCharacters: '<%= Resources.LanguageResource.AS_CommonJS_Msg_IncludedSpeciaCharacters %>',
                AlertMsgInvalidDate: '<%= Resources.LanguageResource.InvalidDate %>',
            };

            actionBarModule.actionContent(content);
            var alowAlert = '<%= GeneralFuncsLib.IsAlertNotification() %>';
            var subDomain = '<%= ConfigurationManager.AppSettings["SubDomain"] %>';
            if (subDomain) {
                actionBarModule.setSubDomain(subDomain);
            }
            $(document).ready(function () {
                if (alowAlert == "True") {
                    actionBarModule.register();
                }
            });
            getClientTimezone();
        </script>
    </form>
    <div class="temp-print"></div>
</body>
</html>
