<configuration>
    <configSections>
        <section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler, log4net" />
        <section name="microsoft.web.services3" type="Microsoft.Web.Services3.Configuration.WebServicesConfiguration, Microsoft.Web.Services3, Version=3.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" />
    	<section name="ABCpdf9.Section" type="WebSupergoo.ABCpdf9.ConfigSection, ABCpdf" allowLocation="true" allowDefinition="Everywhere" allowExeDefinition="MachineToLocalUser" overrideModeDefault="Allow" restartOnExternalChanges="true" requirePermission="true" />
    </configSections> 
    <ABCpdf9.Section>
    	<Preferences>
	   <clear />
	   <add Key="TempDirectory" Value="E:\ABCpdfTemp\VW" /> 
	   <add Key="ClearoutSize" Value="10" />
	</Preferences>
    </ABCpdf9.Section>
    <log4net>

    <appender name="ErrorLog" type="log4net.Appender.RollingFileAppender">
      <param name="File" value="App_Data\\Logs\\MS_STG_1_ERROR.txt" />  
      <param name="AppendToFile" value="true" />
      <param name="RollingStyle" value="Size" />
      <param name="MaxSizeRollBackups" value="50" />
	  <param name="MaximumFileSize" value="4MB" />
      <param name="StaticLogFileName" value="true" />
      <layout type="log4net.Layout.PatternLayout">
        <param name="ConversionPattern" value="%d [%t] %-5p %c - %m%n" />
      </layout>
      <lockingModel type="log4net.Appender.FileAppender+MinimalLock" />
      <filter type="log4net.Filter.LevelRangeFilter">
        <levelMin value="ERROR" />
        <levelMax value="ERROR" />
      </filter>
    </appender>
    <appender name="DebugLog" type="log4net.Appender.RollingFileAppender">
      <param name="File" value="App_Data\\Logs\\MS_STG_1_DEBUG.txt"/> 
      <param name="AppendToFile" value="true" />
      <param name="RollingStyle" value="Size" />
      <param name="MaxSizeRollBackups" value="50" />
      <param name="MaximumFileSize" value="4MB" />
      <param name="StaticLogFileName" value="true" />
      <layout type="log4net.Layout.PatternLayout">
        <param name="ConversionPattern" value="%d [%t] %-5p %c - %m%n" />
      </layout>
      <lockingModel type="log4net.Appender.FileAppender+MinimalLock" />
      <filter type="log4net.Filter.LevelRangeFilter">
        <levelMin value="DEBUG" />
	<levelMax value="DEBUG" />
      </filter>
    </appender>
    <appender name="InfoLog" type="log4net.Appender.RollingFileAppender">
	<param name="File" value="App_Data\\Logs\\MS_STG_1_INFO.txt" />
	<param name="AppendToFile" value="true" />
	<param name="RollingStyle" value="Size" />
	<param name="MaxSizeRollBackups" value="50" />
	<param name="MaximumFileSize" value="4MB" />
	<param name="StaticLogFileName" value="true" />
	<layout type="log4net.Layout.PatternLayout">
		<param name="ConversionPattern" value="%d [%t] %-5p %c - %m%n" />
	</layout>
	<lockingModel type="log4net.Appender.FileAppender+MinimalLock" />
	<filter type="log4net.Filter.LevelRangeFilter">
		<levelMin value="INFO" />
		<levelMax value="INFO" />
	</filter>
    </appender>
    <appender name="WarnLog" type="log4net.Appender.RollingFileAppender">
	<param name="File" value="App_Data\\Logs\\MS_STG_1_WARN.txt" />
	<param name="AppendToFile" value="true" />
	<param name="RollingStyle" value="Size" />
	<param name="MaxSizeRollBackups" value="50" />
	<param name="MaximumFileSize" value="4MB" />
	<param name="StaticLogFileName" value="true" />
	<layout type="log4net.Layout.PatternLayout">
	<param name="ConversionPattern" value="%d [%t] %-5p %c - %m%n" />
	</layout>
	<lockingModel type="log4net.Appender.FileAppender+MinimalLock" />
	<filter type="log4net.Filter.LevelRangeFilter">
		<levelMin value="WARN" />
		<levelMax value="WARN" />
	</filter>
    </appender>
    <root>
      <appender-ref ref="ErrorLog" />
      <appender-ref ref="DebugLog" />
      <appender-ref ref="InfoLog" />
      <appender-ref ref="WarnLog" />
    </root>
    </log4net>
	
