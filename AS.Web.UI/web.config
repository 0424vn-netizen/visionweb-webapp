					<readerQuotas maxDepth="128" maxStringContentLength="2147483647" maxArrayLength="2147483647" maxBytesPerRead="4096" maxNameTableCharCount="16384" />
				</binding>
			</basicHttpBinding>
		</bindings>
		<client>
			<endpoint address="http://localhost:8011/UserMaint.svc" binding="basicHttpBinding" contract="AS.Leads.Domain.Interfaces.IUserMaint" behaviorConfiguration="LeadEndpointBehavior" name="IUserMaint" />

			<endpoint address="http://localhost:55456/EventListenerService.svc" binding="basicHttpBinding" contract="AS.EventHandler.MT.ServiceContract.Interfaces.IEventListenerService" name="IEventListenerService" behaviorConfiguration="LeadEndpointBehavior" />
