<?xml version="1.0"?>
<configuration>
  <configSections>
    <section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler, log4net"/>
    <section name="microsoft.web.services3" type="Microsoft.Web.Services3.Configuration.WebServicesConfiguration, Microsoft.Web.Services3, Version=3.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35"/>
  </configSections>
  <appSettings>
    <add key="aspnet:UseTaskFriendlySynchronizationContext" value="true"/>
    <add key="DefaultAsClientId" value="22"/>
    <add key="ApiServiceName" value="VW APIs"/>
    <add key="ApiWsdlServiceNamespace" value="http://api.VW.com/types"/>
    <add key="ApiAuthenticationRedirectUrl" value="http://www2.fdportfoliomanager.com"/>
    <add key="ApiDefaultVersion" value="1.0"/>
    <add key="ApiEnableRequestTracking" value="1"/>
    <add key="ApiWebServiceUrl" value="http://localhost:20001/ApiServices.asmx"/>
    <add key="ApiWebServiceToken1" value="Zd8fFFrrOAGq+qH5hs7OhQ=="/>
    <add key="ApiWebServiceToken2" value="pd2ho0N4A+YqQpWsJfV3tw=="/>
  </appSettings>
  <log4net>
    <appender name="RollingFileAppender" type="log4net.Appender.RollingFileAppender">
      <param name="File" value="App_Data\\Logs\\FE_Log.txt"/>
      <param name="AppendToFile" value="true"/>
      <param name="RollingStyle" value="Size"/>
      <param name="MaxSizeRollBackups" value="10"/>
      <param name="MaximumFileSize" value="2MB"/>
      <param name="StaticLogFileName" value="true"/>
      <layout type="log4net.Layout.PatternLayout">
        <param name="ConversionPattern" value="%d [%t] %-5p %c - %m%n"/>
      </layout>
    </appender>
    <root>
      <level value="DEBUG"/>
      <appender-ref ref="RollingFileAppender"/>
    </root>
  </log4net>
  <microsoft.web.services3>
    <security>
      <timeToleranceInSeconds value="86400"/>
      <defaultTtlInSeconds value="86400"/>
    </security>
    <policy fileName="wse3policyCache.config"/>
  </microsoft.web.services3>
  <!--
    For a description of web.config changes see http://go.microsoft.com/fwlink/?LinkId=235367.

    The following attributes can be set on the <httpRuntime> tag.
      <system.Web>
        <httpRuntime targetFramework="4.5.2" />
      </system.Web>
  -->
  <system.web>
    <compilation debug="true" targetFramework="4.5.2"/>
    <httpRuntime executionTimeout="300" enableVersionHeader="false" maxRequestLength="40960" />
    <customErrors mode="Off" defaultRedirect="error.htm"/>
    <authentication mode="None"/>
  </system.web>
  <system.serviceModel>
    <behaviors>
      <serviceBehaviors>
        <behavior name="serviceBehaviorConfig">
          <!-- To avoid disclosing metadata information, set the values below to false before deployment -->
          <serviceMetadata httpGetEnabled="true" httpsGetEnabled="true"/>
          <!-- To receive exception details in faults for debugging purposes, set the value below to true.  Set to false before deployment to avoid disclosing exception information -->
          <serviceDebug includeExceptionDetailInFaults="true"/>
        </behavior>
      </serviceBehaviors>
      <endpointBehaviors>
        <behavior name="pox">
          <webHttp helpEnabled="true" automaticFormatSelectionEnabled="true" defaultBodyStyle="Bare"/>
        </behavior>
        <behavior name="restServiceBehavior">
          <webHttp helpEnabled="true" automaticFormatSelectionEnabled="true" defaultBodyStyle="Bare"/>
        </behavior>
      </endpointBehaviors>
    </behaviors>
    <bindings>
      <basicHttpBinding>
        <binding name="soapBinding">
          <security mode="None"/>
        </binding>
        <binding name="securedSoapBinding">
          <security mode="TransportWithMessageCredential">
            <transport clientCredentialType="Basic"/>
            <message clientCredentialType="UserName"/>
          </security>
        </binding>
      </basicHttpBinding>
      <webHttpBinding>
        <binding name="restBinding">
          <security mode="None">
            <transport clientCredentialType="None"/>
          </security>
        </binding>
        <binding name="securedRestBinding">
          <security mode="Transport">
            <transport clientCredentialType="None"/>
          </security>
        </binding>
      </webHttpBinding>
    </bindings>
    <serviceHostingEnvironment aspNetCompatibilityEnabled="true" multipleSiteBindingsEnabled="true"/>
    <services>
      <service name="AS.VW.Api.WCF.ApiReport" behaviorConfiguration="serviceBehaviorConfig">
        <endpoint address="AuthorizationService" binding="webHttpBinding" contract="AS.VW.Api.WCF.ServiceInterface.IAuthorizationService" behaviorConfiguration="pox" bindingConfiguration="restBinding"/>
        <endpoint address="" binding="basicHttpBinding" contract="AS.VW.Api.WCF.ServiceInterface.IAuthorizationService" bindingConfiguration="soapBinding"/>
        <endpoint address="BatchService" binding="webHttpBinding" contract="AS.VW.Api.WCF.ServiceInterface.IBatchService" behaviorConfiguration="pox" bindingConfiguration="restBinding"/>
        <endpoint address="" binding="basicHttpBinding" contract="AS.VW.Api.WCF.ServiceInterface.IBatchService" bindingConfiguration="soapBinding"/>
        <endpoint address="ChargebackService" binding="webHttpBinding" contract="AS.VW.Api.WCF.ServiceInterface.IChargebackService" behaviorConfiguration="pox" bindingConfiguration="restBinding"/>
        <endpoint address="" binding="basicHttpBinding" contract="AS.VW.Api.WCF.ServiceInterface.IChargebackService" bindingConfiguration="soapBinding"/>
        <endpoint address="PaymentService" binding="webHttpBinding" contract="AS.VW.Api.WCF.ServiceInterface.IPaymentService" behaviorConfiguration="pox" bindingConfiguration="restBinding"/>
        <endpoint address="" binding="basicHttpBinding" contract="AS.VW.Api.WCF.ServiceInterface.IPaymentService" bindingConfiguration="soapBinding"/>
        <endpoint address="RetrievalService" binding="webHttpBinding" contract="AS.VW.Api.WCF.ServiceInterface.IRetrievalService" behaviorConfiguration="pox" bindingConfiguration="restBinding"/>
        <endpoint address="" binding="basicHttpBinding" contract="AS.VW.Api.WCF.ServiceInterface.IRetrievalService" bindingConfiguration="soapBinding"/>
        <endpoint address="ReturnService" binding="webHttpBinding" contract="AS.VW.Api.WCF.ServiceInterface.IReturnService" behaviorConfiguration="pox" bindingConfiguration="restBinding"/>
        <endpoint address="" binding="basicHttpBinding" contract="AS.VW.Api.WCF.ServiceInterface.IReturnService" bindingConfiguration="soapBinding"/>
        <endpoint address="TransactionService" binding="webHttpBinding" contract="AS.VW.Api.WCF.ServiceInterface.ITransactionService" behaviorConfiguration="pox" bindingConfiguration="restBinding"/>
        <endpoint address="" binding="basicHttpBinding" contract="AS.VW.Api.WCF.ServiceInterface.ITransactionService" bindingConfiguration="soapBinding"/>
      </service>
    </services>
  </system.serviceModel>
  <system.webServer>
    <validation validateIntegratedModeConfiguration="false"/>
    <modules runAllManagedModulesForAllRequests="true"/>
    <!--
        To browse web app root directory during debugging, set the value below to true.
        Set to false before deployment to avoid disclosing web app folder information.
      -->
    <directoryBrowse enabled="true"/>
    <httpErrors errorMode="DetailedLocalOnly"/>
  </system.webServer>
</configuration>